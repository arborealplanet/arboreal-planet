{
  "manifest_version": 3,
  "name": "Snake Sorter Browser Helper",
  "version": "0.5.0",
  "description": "Owner-only helper that reads the currently open MorphMarket GTP listing and sends exposed gallery image references to Snake Sorter.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.morphmarket.com/*",
    "https://morphmarket.com/*",
    "https://arboreal-planet.vercel.app/*"
  ],
  "action": {
    "default_title": "Send listing to Snake Sorter",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.morphmarket.com/*",
        "https://morphmarket.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://arboreal-planet.vercel.app/snake-sorter*"
      ],
      "js": [
        "app-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}