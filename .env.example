# Copy to .env.local and fill in. Never commit real values.

# Supabase project (auth + database + storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical site URL (used for absolute links/redirects)
NEXT_PUBLIC_SITE_URL=

# Snake Sorter inference service (optional; classification falls back when unset)
SNAKE_SORTER_INFERENCE_URL=
SNAKE_SORTER_INFERENCE_TOKEN=
